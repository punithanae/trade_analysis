# ============================================================
#  AI CRYPTO TRADING BOT - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real keys
# NEVER share your .env file or commit it to Git

# --- MUDREX ---
MUDREX_API_SECRET=your_mudrex_api_secret_here

# --- NVIDIA NIM ---
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- CRYPTOPANIC (Free at cryptopanic.com → Developers → API) ---
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# --- TRADING CONFIG (optional overrides) ---
# DRY_RUN=true          # Set to true to simulate trades without real orders
# RISK_PER_TRADE=1.5    # % of wallet per trade (default: 1.5)
# MAX_POSITIONS=3       # Max simultaneous open positions (default: 3)
# LEVERAGE=5            # Futures leverage (default: 5)
